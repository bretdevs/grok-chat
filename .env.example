# Everything here is optional. Users bring their own xAI key in the UI.

# Fallback E2B key for Agent mode when the user has not added one in Settings.
# On a public deployment, anyone who opens the site can start sandboxes on this account.
E2B_API_KEY=

# Custom sandbox template name (see README, "Custom sandbox template").
E2B_TEMPLATE=

# Send model requests to an OpenAI-compatible gateway, a proxy or a local mock instead of
# https://api.x.ai/v1 (see README, "Using a gateway instead of api.x.ai").
XAI_BASE_URL=

# on / off: link turns with previous_response_id. Default: on for api.x.ai, off for any other host.
XAI_CHAIN_RESPONSES=
