# Everything here is optional. With none of it set, every visitor brings their own xAI key
# and nothing is stored on the server.

# --- Accounts -----------------------------------------------------------------
# A Postgres connection string turns on sign-in. The tables are created on the first request.
# Without it the app has no accounts and no login screen.
DATABASE_URL=

# The key signed-in accounts spend, so nobody needs a key of their own. Leave it empty to
# make everyone bring their own. A key added in Settings always wins over this one.
XAI_API_KEY=

# Messages per account per day on the key above. 0 means no limit. Default: 50.
DAILY_MESSAGE_LIMIT=

# These addresses become admins when they sign up (comma separated). The very first
# account on an empty database is an admin anyway.
ADMIN_EMAIL=

# off closes sign-up, so only accounts that already exist can get in.
SIGNUP_OPEN=

# When set, sign-up also asks for this code.
SIGNUP_CODE=

# off keeps the accounts in the database but drops the login screen, back to bring-your-own-key.
AUTH_REQUIRED=

# --- Agent mode ---------------------------------------------------------------
# Fallback E2B key for Agent mode when the user has not added one in Settings.
# On a public deployment, anyone who signs in can start sandboxes on this account.
E2B_API_KEY=

# Custom sandbox template name (see README, "Custom sandbox template").
E2B_TEMPLATE=

# --- Model endpoint -----------------------------------------------------------
# Send model requests to an OpenAI-compatible gateway, a proxy or a local mock instead of
# https://api.x.ai/v1 (see README, "Using a gateway instead of api.x.ai").
XAI_BASE_URL=

# on / off: link turns with previous_response_id. Default: on for api.x.ai, off for any other host.
XAI_CHAIN_RESPONSES=
